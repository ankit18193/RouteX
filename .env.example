# ==============================================================================
# RouteX Environment Configuration Template
# Copy to .env or customize for your deployment environment
# ==============================================================================

# Server configuration
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=json

# Configuration file paths
ROUTEX_CONFIG_PATH=config/gateway.config.yaml
ROUTEX_ROUTES_PATH=config/routes.yaml

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication secrets (development default)
JWT_HS256_SECRET=routex-dev-super-secret-key-for-testing-at-least-32-chars-long!
